{
  "expo": {
    "name": "Mobile Billiards",
    "slug": "mobile-billiards-game",
    "version": "0.1.0",
    "orientation": "landscape",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b3d0b"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.mobilebilliards"
    },
    "android": {
      "package": "com.example.mobilebilliards",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b3d0b"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
